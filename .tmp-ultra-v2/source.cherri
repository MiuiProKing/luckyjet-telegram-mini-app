#include 'actions/device'
#include 'actions/settings'
#include 'actions/a11y'

showNotification("Включаю максимальную экономию батареи.", "🪫 ULTRA Экономия v2", true)
setAirplaneMode(true)
setWifi(false)
setBluetooth(false)
setCellularData(false)
setHotspot(false)
setLowPowerMode(true)
darkMode()
setBrightness(0.02)
setWhitePoint(true)
showNotification("🪫 ULTRA-экономия включена.", "Готово", true)
