#include 'actions/device'
#include 'actions/settings'
#include 'actions/a11y'

showNotification("Включаю максимальный режим выживания батареи.", "🆘 ULTRA SURVIVAL v3", true)
flashlightOff()
setAirplaneMode(true)
setWifi(false)
setBluetooth(false)
setCellularData(false)
setHotspot(false)
setLowPowerMode(true)
darkMode()
setBrightness(0.0)
setWhitePoint(true)
setReduceMotion(true)
setReduceTransparency(true)
showNotification("Максимальная экономия включена. Экран сейчас заблокируется.", "🪫 SURVIVAL активен", true)
lockScreen()
