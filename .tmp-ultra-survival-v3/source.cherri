#include 'actions/device'
#include 'actions/settings'
#include 'actions/a11y'

showNotification("Включаю самый жёсткий режим экономии. Экран будет заблокирован в конце.", "🆘 ULTRA SURVIVAL v3", true)

flashlightOff()
setAirplaneMode(true)
setWifi(false)
setBluetooth(false)
setCellularData(false)
setHotspot(false)
setLowPowerMode(true)

darkMode()
setBrightness(0.0)
setWhitePoint(true)
setReduceMotion(true)
setReduceTransparency(true)
setBackgroundSounds(false)
setMediaBackgroundSounds(false)
setSoundRecognition("pause")

showNotification("Максимальная экономия включена. Блокирую экран.", "🪫 SURVIVAL активирован", true)
wait(1)
lockScreen()
